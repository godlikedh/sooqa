# Optional path to a TOML configuration file.
# SOOQA_CONFIG_FILE=config.toml

# Environment variables override values from the TOML file.
# SOOQA_SERVER_LISTEN_ADDRESS=0.0.0.0:8080
# SOOQA_WORKER_POLL_INTERVAL_SECONDS=5
# SOOQA_WORKER_LEASE_DURATION_SECONDS=60
# SOOQA_COMPANION_LISTEN_ADDRESS=127.0.0.1:47831
# DATABASE_URL=postgres://sooqa:sooqa_dev_only@127.0.0.1:5432/sooqa
# SOOQA_DATABASE_MAX_CONNECTIONS=20
# SOOQA_OBSERVABILITY_LOG_FORMAT=json
# SOOQA_OBSERVABILITY_LOG_LEVEL=info

# Secrets are accepted only for configuration plumbing in this slice and are
# redacted from summaries and Debug output.
# SOOQA_DATABASE_URL=postgres://...
# SOOQA_TELEGRAM_BOT_TOKEN=...
