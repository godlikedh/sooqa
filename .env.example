# Optional path to a TOML configuration file.
# SOOQA_CONFIG_FILE=config.toml

# Environment variables override values from the TOML file.
# SOOQA_SERVER_LISTEN_ADDRESS=0.0.0.0:8080
# SOOQA_WORKER_POLL_INTERVAL_SECONDS=5
# SOOQA_WORKER_LEASE_DURATION_SECONDS=60
# SOOQA_MEDIA_WORK_ROOT=/var/lib/sooqa/work
# SOOQA_MEDIA_FFMPEG_PATH=ffmpeg
# SOOQA_MEDIA_FFPROBE_PATH=ffprobe
# SOOQA_MEDIA_YTDLP_PATH=yt-dlp
# SOOQA_MEDIA_YTDLP_FORMAT=bestvideo*+bestaudio/best
# SOOQA_MEDIA_YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416
# SOOQA_MEDIA_PROCESSING_TIMEOUT_SECONDS=3600
# SOOQA_MEDIA_SOURCE_DOWNLOAD_MAX_BYTES=8589934592
# SOOQA_MEDIA_NORMALIZED_STORAGE_MAX_BYTES=1900000000
# SOOQA_COMPANION_LISTEN_ADDRESS=127.0.0.1:47831
# SOOQA_COMPANION_BACKEND_URL=http://127.0.0.1:8080
# SOOQA_COMPANION_LOCAL_TOKEN=generate-a-separate-random-local-token
# SOOQA_COMPANION_BACKEND_TOKEN=the-server-api-token
# SOOQA_COMPANION_REQUEST_BODY_LIMIT_BYTES=65536
# SOOQA_COMPANION_REQUEST_TIMEOUT_SECONDS=15
# DATABASE_URL=postgres://sooqa:sooqa_dev_only@127.0.0.1:5432/sooqa
# SOOQA_DATABASE_MAX_CONNECTIONS=20
# SOOQA_OBSERVABILITY_LOG_FORMAT=json
# SOOQA_OBSERVABILITY_LOG_LEVEL=info

# Secrets are accepted only for configuration plumbing in this slice and are
# redacted from summaries and Debug output.
# SOOQA_DATABASE_URL=postgres://...
# SOOQA_TELEGRAM_BOT_TOKEN=...
# SOOQA_TELEGRAM_API_BASE_URL=https://api.telegram.org
# SOOQA_TELEGRAM_ADMIN_USER_IDS=123456789
# SOOQA_TELEGRAM_POLL_TIMEOUT_SECONDS=30
# SOOQA_TELEGRAM_UPLOAD_TIMEOUT_SECONDS=3600
# SOOQA_TELEGRAM_SOURCE_DOWNLOAD_MAX_BYTES=2147483648
# Worker-only root for absolute file paths returned by a local Bot API server.
# SOOQA_TELEGRAM_LOCAL_FILE_ROOT=/var/lib/telegram-bot-api
# SOOQA_TELEGRAM_STORAGE_CHAT_ID=-1001234567890
