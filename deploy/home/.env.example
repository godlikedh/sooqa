# Copy this file to deploy/home/.env and replace every placeholder.
# Do not commit the resulting .env file.

POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://sooqa:replace-with-a-long-random-password@postgres:5432/sooqa

# Obtain these from https://my.telegram.org/apps for the official local Bot API server.
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash

SOOQA_API_TOKEN=replace-with-a-long-random-api-secret
SOOQA_TELEGRAM_BOT_TOKEN=replace-with-bot-token
SOOQA_TELEGRAM_ADMIN_USER_IDS=123456789
SOOQA_TELEGRAM_STORAGE_CHAT_ID=-1001234567890

# Optional overrides. URL sources may exceed 2 GB; canonical output must remain
# below Telegram's documented 2000 MB local upload limit.
# SOOQA_MEDIA_SOURCE_DOWNLOAD_MAX_BYTES=8589934592
# SOOQA_MEDIA_NORMALIZED_STORAGE_MAX_BYTES=1900000000
# Full Telegram storage upload deadline; maximum is 24 hours.
# SOOQA_TELEGRAM_UPLOAD_TIMEOUT_SECONDS=3600
# SOOQA_TELEGRAM_SOURCE_DOWNLOAD_MAX_BYTES=2147483648
